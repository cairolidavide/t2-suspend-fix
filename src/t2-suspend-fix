#!/bin/bash
# t2-suspend-fix - systemd-sleep hook for Apple T2 Macs running Linux
# https://github.com/cairolidavide/t2-suspend-fix
#
# Installed in /usr/lib/systemd/system-sleep/ and run by systemd-sleep with:
#   pre  <suspend|hibernate|hybrid-sleep|suspend-then-hibernate>
#   post <suspend|hibernate|hybrid-sleep|suspend-then-hibernate>
# plus an internal "resume" phase started with systemd-run after "post".
#
# What it does (each step is auto-detected and can be disabled in
# /etc/t2-suspend-fix.conf):
#
# 1. Wi-Fi / Bluetooth: the Broadcom brcmfmac driver can fail pci_pm_suspend
#    (-EIO) and abort the suspend. Repeated aborted suspends make the T2 time
#    out, killing keyboard, trackpad, Touch Bar and audio. Wi-Fi and
#    Bluetooth are functions of the same chip, so both drivers are unloaded
#    before sleeping (Bluetooth first) and reloaded afterwards.
# 2. Thunderbolt: the Intel Thunderbolt 3 bridge can take ~10 s to resume,
#    delaying the whole wake-up. If nothing is plugged into the USB-C ports,
#    the Thunderbolt PCI branch is removed before sleeping and rescanned
#    right after (~50 ms).
# 3. Touch Bar: on resume the T2 re-enumerates the Touch Bar, so tiny-dfr
#    (bound to its devices) stops and must be restarted. The backlight driver
#    is reloaded with brightness=0 so the Touch Bar stays dark until tiny-dfr
#    is ready, instead of flashing the default layout.
# 4. The keyboard backlight level is restored, and optionally user services
#    that keep stale sysfs handles are restarted.
# 5. Failsafe: if the lid is closed and the T2 stopped answering during a
#    suspend (its USB bus is left without devices: keyboard, trackpad, Touch
#    Bar and audio dead), or suspend keeps failing, the Mac is powered off:
#    otherwise logind retries the suspend in a loop all night, with the Mac
#    awake and hot in a bag. Optionally (T2_RECOVERY=yes, experimental) the
#    T2 driver is first unbound and probed again.
#
# The T2 driver (apple-bce / t2bce) is not unloaded before sleeping: recent
# drivers save and restore its state natively.

set -u

NAME=t2-suspend-fix
CONF=/etc/t2-suspend-fix.conf
STATE=/run/t2-suspend-fix
SELF=$(readlink -f "$0")

# Defaults, overridable in $CONF
RELOAD_WIFI_BT=yes
FAST_THUNDERBOLT_RESUME=auto
TOUCHBAR_FIX=auto
RESTORE_KBD_BACKLIGHT=yes
RESTART_USER_SERVICES=""
# Off by default: with the t2bce driver, unbinding t2bce_core leaves
# t2bce_vhci running on the old mappings and the kernel oopses
T2_RECOVERY=no
T2_RECOVERY_ATTEMPTS=2
FAILSAFE_POWEROFF=yes
FAILSAFE_MAX_FAILURES=3
[ -r "$CONF" ] && . "$CONF"

KBD=/sys/class/leds/apple::kbd_backlight
# Consecutive failed suspends; outside $STATE, which is reset at every "pre"
FAILURES=/run/$NAME.failures

log() { logger -t "$NAME" "$*"; }
log_crit() { logger -t "$NAME" -p crit "$*"; }
run() { "$@" 2>&1 | logger -t "$NAME"; }
attr() { cat "$1/$2" 2>/dev/null; }

is_t2() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [ "$(attr "$d" vendor)" = 0x106b ] && [ "$(attr "$d" device)" = 0x1801 ] && return 0
  done
  return 1
}

# --- Wi-Fi / Bluetooth ------------------------------------------------------

# Kernel modules bound to Broadcom PCI functions: Bluetooth first, then Wi-Fi
broadcom_modules() {
  local d mod bt="" wifi=""
  for d in /sys/bus/pci/devices/*; do
    [ "$(attr "$d" vendor)" = 0x14e4 ] && [ -e "$d/driver/module" ] || continue
    mod=$(basename "$(readlink -f "$d/driver/module")")
    case "$mod" in
      hci_*) bt="$bt $mod" ;;
      *)     wifi="$wifi $mod" ;;
    esac
  done
  echo $bt $wifi | tr ' ' '\n' | awk 'NF && !seen[$0]++'
}

# Unload a module after the modules that depend on it (e.g. brcmfmac_wcc)
unload_tree() {
  local h
  for h in /sys/module/"$1"/holders/*; do
    [ -e "$h" ] && unload_tree "${h##*/}"
  done
  [ -e /sys/module/"$1" ] && run modprobe -r "$1"
}

# --- Thunderbolt ------------------------------------------------------------

# "root_port branch_top" for every Thunderbolt controller (NHI) that sits
# behind a PCIe bridge, e.g. "0000:00:1c.4 0000:03:00.0". CPU-integrated
# Thunderbolt (NHI directly on the root bus) is skipped.
thunderbolt_branches() {
  local d p parts
  for d in /sys/bus/pci/devices/*; do
    [ "$(attr "$d" vendor)" = 0x8086 ] && [ "$(attr "$d" class)" = 0x088000 ] || continue
    p=$(readlink -f "$d")
    IFS=/ read -ra parts <<< "${p#/sys/devices/}"
    # pci0000:00 / root port / branch top / ... / NHI
    [ "${#parts[@]}" -ge 4 ] || continue
    case "$(attr "/sys/bus/pci/devices/${parts[2]}" class)" in
      0x0604*) echo "${parts[1]} ${parts[2]}" ;;
    esac
  done | sort -u
}

# True if nothing is plugged into the USB-C ports behind this root port
usbc_idle() {
  local root=$1
  # USB devices other than the controller's own root hubs (vendor 1d6b)
  find "$(readlink -f "/sys/bus/pci/devices/$root")" -name idVendor -exec cat {} + 2>/dev/null \
    | grep -qv '^1d6b$' && return 1
  # Thunderbolt devices other than the host routers (X-0)
  ls /sys/bus/thunderbolt/devices/ 2>/dev/null | grep -qE '^[0-9]+-[1-9]' && return 1
  # External displays (DisplayPort alt mode)
  grep -qx connected /sys/class/drm/card*-{DP,HDMI-A}-*/status 2>/dev/null && return 1
  return 0
}

# --- Touch Bar --------------------------------------------------------------

tinydfr_wait_devices() {
  local i
  for i in $(seq 100); do
    systemctl is-active --quiet dev-tiny_dfr_display.device \
      dev-tiny_dfr_backlight.device && return 0
    sleep 0.02
  done
  return 1
}

# --- T2 health and recovery -------------------------------------------------

# PCI address of a T2 function: 0x1801 bridge (BCE), 0x1803 audio
t2_function() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [ "$(attr "$d" vendor)" = 0x106b ] && [ "$(attr "$d" device)" = "$1" ] \
      && { echo "${d##*/}"; return 0; }
  done
  return 1
}

# Number of USB devices on the T2 virtual USB bus (keyboard, trackpad, Touch
# Bar, camera, ...). When the T2 stops answering ("HC died") they all
# disconnect, while the bus itself may stay.
t2_usb_devices() {
  local bridge hub n=0
  bridge=$(t2_function 0x1801) || { echo 0; return; }
  for hub in /sys/bus/usb/devices/usb*; do
    case "$(readlink -f "$hub")" in
      */"$bridge"/*)
        n=$(find "$(readlink -f "$hub")" -maxdepth 1 -regextype egrep \
              -regex '.*/[0-9]+-[0-9.]+' | wc -l)
        break ;;
    esac
  done
  echo "$n"
}

# Wait up to $1 seconds for the T2 USB devices to be there
t2_wait_alive() {
  local i
  for i in $(seq $(( $1 * 10 ))); do
    [ "$(t2_usb_devices)" -gt 0 ] && return 0
    sleep 0.1
  done
  [ "$(t2_usb_devices)" -gt 0 ]
}

# Write $2 to sysfs file $3, giving up after $1 seconds: with a dead T2 the
# driver's remove callback can block on commands that never complete
write_timeout() {
  local secs=$1 value=$2 file=$3 pid i
  ( echo "$value" > "$file" ) 2>/dev/null &
  pid=$!
  for i in $(seq $(( secs * 10 ))); do
    kill -0 "$pid" 2>/dev/null || { wait "$pid"; return; }
    sleep 0.1
  done
  log "T2 recovery: writing $value to $file still blocked after ${secs}s"
  return 2
}

# Unbind the T2 drivers (audio first, it depends on the bridge) and let the
# kernel probe them again. No PCI reset: the T2 functions have no reset method
# and a bus reset would also hit the internal SSD on the same slot.
# EXPERIMENTAL: on t2bce 0.07 (kernel 7.2) unbinding t2bce_core leaves the
# t2bce_vhci child device bound (device_links_driver_cleanup warning) and a
# t2bce_vhci worker then writes to the unmapped registers: kernel oops.
t2_recover() {
  local bridge audio dev drv
  bridge=$(t2_function 0x1801) || return 1
  audio=$(t2_function 0x1803)
  for dev in $audio $bridge; do
    [ -e "/sys/bus/pci/devices/$dev/driver" ] || continue
    drv=$(readlink -f "/sys/bus/pci/devices/$dev/driver")
    write_timeout 10 "$dev" "$drv/unbind" || return 2
  done
  for dev in $bridge $audio; do
    [ -e "/sys/bus/pci/devices/$dev/driver" ] && continue
    write_timeout 10 "$dev" /sys/bus/pci/drivers_probe || return 2
  done
  t2_wait_alive 10
}

# Try T2_RECOVERY_ATTEMPTS times; stop early if a sysfs write hangs, since
# the device lock stays held and further attempts would hang too
t2_recover_attempts() {
  local i rc
  for i in $(seq "$T2_RECOVERY_ATTEMPTS"); do
    log "$1: T2 not answering (no devices on its USB bus), recovery attempt $i/$T2_RECOVERY_ATTEMPTS"
    t2_recover; rc=$?
    if [ "$rc" -eq 0 ]; then
      log "$1: T2 recovered, $(t2_usb_devices) USB devices back"
      return 0
    fi
    [ "$rc" -eq 2 ] && break
  done
  log_crit "$1: T2 recovery failed: keyboard, trackpad, Touch Bar and audio stay dead until reboot"
  return 1
}

lid_closed() {
  grep -qs closed /proc/acpi/button/lid/*/state
}

# After a suspend: count failures, revive the T2 if needed, and power off if
# the lid is closed and the Mac cannot sleep (logind would retry forever).
# Returns 1 if a power-off was requested.
failsafe() {
  local before now failed=0 t2ok=yes reason=""
  before=$(cat "$STATE/suspend-fail" 2>/dev/null)
  now=$(attr /sys/power/suspend_stats fail)
  if [ -n "$before" ] && [ -n "$now" ] && [ "$now" -gt "$before" ]; then
    failed=$(( $(cat "$FAILURES" 2>/dev/null || echo 0) + 1 ))
    echo "$failed" > "$FAILURES"
    log "$1: suspend failed ($failed in a row), last failed device: $(attr /sys/power/suspend_stats last_failed_dev)"
  else
    rm -f "$FAILURES"
  fi

  # Grace period: the T2 re-enumerates some devices during resume
  if ! t2_wait_alive 3; then
    t2ok=no
    [ "$T2_RECOVERY" = yes ] && t2_recover_attempts "$1" && t2ok=yes
  fi

  [ "$FAILSAFE_POWEROFF" = yes ] && lid_closed || return 0
  if [ "$t2ok" = no ]; then
    reason="T2 not answering"
  elif [ "$failed" -ge "$FAILSAFE_MAX_FAILURES" ]; then
    reason="$failed failed suspends in a row"
  fi
  [ -n "$reason" ] || return 0
  log_crit "$1: $reason with the lid closed: powering off instead of retrying the suspend in a loop"
  systemctl poweroff --no-block
  return 1
}

# ---------------------------------------------------------------------------

if ! is_t2; then
  [ "${1:-}" = detect ] && echo "No Apple T2 (PCI 106b:1801) found: nothing to do."
  exit 0
fi

case "${1:-}" in
  detect)
    # Read-only: show what the hook would act on
    echo "Model:                 $(attr /sys/class/dmi/id product_name)"
    echo "Kernel:                $(uname -r)"
    echo "Wi-Fi/BT modules:      $(broadcom_modules | tr '\n' ' ')"
    branches=$(thunderbolt_branches)
    if [ -n "$branches" ]; then
      while read -r root branch; do
        state=idle; usbc_idle "$root" || state="in use"
        echo "Thunderbolt branch:    $branch (root port $root, USB-C $state)"
      done <<< "$branches"
    else
      echo "Thunderbolt branch:    none behind a PCIe bridge"
    fi
    echo "tiny-dfr:              $(systemctl is-active tiny-dfr.service 2>/dev/null)"
    n=$(t2_usb_devices)
    echo "T2 USB bus:            $n devices$([ "$n" -eq 0 ] && echo " (T2 NOT ANSWERING: sudo $SELF recover)")"
    echo "Touch Bar backlight:   $([ -e /sys/module/hid_appletb_bl ] && echo hid_appletb_bl || echo not loaded)"
    echo "Keyboard backlight:    $([ -e "$KBD" ] && echo "$KBD" || echo none)"
    echo "Config:                $([ -r "$CONF" ] && echo "$CONF" || echo "defaults")"
    echo "  RELOAD_WIFI_BT=$RELOAD_WIFI_BT FAST_THUNDERBOLT_RESUME=$FAST_THUNDERBOLT_RESUME TOUCHBAR_FIX=$TOUCHBAR_FIX"
    echo "  RESTORE_KBD_BACKLIGHT=$RESTORE_KBD_BACKLIGHT RESTART_USER_SERVICES=\"$RESTART_USER_SERVICES\""
    echo "  T2_RECOVERY=$T2_RECOVERY T2_RECOVERY_ATTEMPTS=$T2_RECOVERY_ATTEMPTS FAILSAFE_POWEROFF=$FAILSAFE_POWEROFF FAILSAFE_MAX_FAILURES=$FAILSAFE_MAX_FAILURES"
    ;;

  recover)
    # Manual: sudo /usr/lib/systemd/system-sleep/t2-suspend-fix recover
    # Experimental, see t2_recover: can oops the kernel with t2bce
    [ "$(id -u)" -eq 0 ] || { echo "Run as root: sudo $SELF recover" >&2; exit 1; }
    echo "WARNING: experimental. With the t2bce driver this can crash the kernel (oops); save your work first." >&2
    if [ "$(t2_usb_devices)" -gt 0 ] && [ "${2:-}" != --force ]; then
      echo "The T2 is answering ($(t2_usb_devices) USB devices): nothing to do (--force to re-bind anyway)."
      exit 0
    fi
    T2_RECOVERY_ATTEMPTS=1
    if t2_recover_attempts recover; then
      systemctl try-restart tiny-dfr.service
      echo "T2 recovered: $(t2_usb_devices) USB devices."
    else
      echo "T2 recovery failed: reboot to get keyboard and trackpad back." >&2
      exit 1
    fi
    ;;

  pre)
    rm -rf "$STATE"; mkdir -p "$STATE"
    log "pre $2: $(attr /sys/class/dmi/id product_name), kernel $(uname -r)"
    attr /sys/power/suspend_stats fail > "$STATE/suspend-fail"

    if systemctl is-active --quiet tiny-dfr.service; then
      touch "$STATE/tinydfr"
      if [ "$TOUCHBAR_FIX" != no ] && [ -e /sys/module/hid_appletb_bl ]; then
        touch "$STATE/touchbar-bl"
        run modprobe -r hid_appletb_bl
      fi
    fi

    if [ "$RESTORE_KBD_BACKLIGHT" = yes ] && [ -e "$KBD/brightness" ]; then
      cat "$KBD/brightness" > "$STATE/kbd-backlight"
    fi

    if [ "$RELOAD_WIFI_BT" = yes ]; then
      broadcom_modules > "$STATE/modules"
      log "pre $2: unloading $(tr '\n' ' ' < "$STATE/modules")"
      while read -r m; do unload_tree "$m"; done < "$STATE/modules"
    fi

    if [ "$FAST_THUNDERBOLT_RESUME" != no ]; then
      thunderbolt_branches | while read -r root branch; do
        if usbc_idle "$root"; then
          log "pre $2: removing Thunderbolt branch $branch (root port $root)"
          echo "$root $branch" >> "$STATE/thunderbolt"
          echo 1 > "/sys/bus/pci/devices/$branch/remove"
        else
          log "pre $2: USB-C in use behind $root, keeping Thunderbolt (slow resume)"
        fi
      done
    fi
    ;;

  post)
    # Synchronous: the USB-C ports must never stay without their bus
    if [ -s "$STATE/thunderbolt" ]; then
      while read -r root branch; do
        [ -e "/sys/bus/pci/devices/$branch" ] && continue
        echo 1 > "/sys/bus/pci/devices/$root/rescan"
        log "post $2: Thunderbolt rescan of $root, branch back: $([ -e "/sys/bus/pci/devices/$branch" ] && echo yes || echo NO)"
      done < "$STATE/thunderbolt"
    fi

    # Before tiny-dfr: the Touch Bar needs a working T2
    failsafe "post $2" || exit 0

    # tiny-dfr fails immediately if its devices are not active yet in
    # systemd, so wait for them (tens of ms, 2 s at most) before restarting
    if [ -e "$STATE/tinydfr" ]; then
      [ -e "$STATE/touchbar-bl" ] && run modprobe hid_appletb_bl brightness=0
      tinydfr_wait_devices
      systemctl restart --no-block tiny-dfr.service
    fi

    # Everything else runs in the background, outside the hook's cgroup:
    # the desktop is already awake and should not wait for it
    log "post $2: scheduling resume tasks"
    run systemd-run --no-block --unit="$NAME-resume-$$" "$SELF" resume
    ;;

  resume)
    udevadm settle --timeout=5

    # Safety net in case the restart in "post" failed
    if [ -e "$STATE/tinydfr" ] && ! systemctl is-active --quiet tiny-dfr.service; then
      log "resume: tiny-dfr not running, starting it"
      systemctl start tiny-dfr.service
    fi

    if [ -s "$STATE/modules" ]; then
      # Reverse order: Wi-Fi first, then Bluetooth
      log "resume: reloading $(tac "$STATE/modules" | tr '\n' ' ')"
      tac "$STATE/modules" | while read -r m; do run modprobe "$m"; done
      udevadm settle --timeout=5
    fi

    if [ -s "$STATE/kbd-backlight" ] && [ -e "$KBD/brightness" ]; then
      cat "$STATE/kbd-backlight" > "$KBD/brightness" 2>/dev/null
    fi

    # Restart user services that keep stale sysfs handles (only if running)
    if [ -n "$RESTART_USER_SERVICES" ]; then
      for d in /run/user/[0-9]*; do
        u=$(id -nu "${d##*/}" 2>/dev/null) || continue
        systemctl --user -M "$u@" try-restart $RESTART_USER_SERVICES 2>/dev/null
      done
    fi
    log "resume: done"
    ;;
esac
exit 0
